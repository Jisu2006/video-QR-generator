# Video QR Generator - Environment Configuration

# Flask Secret Key (generate a strong random string in production)
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production

# App Environment: development / production
FLASK_ENV=development

# Server Port
PORT=5000

# Base URL used for generating QR Code Links
# Options:
# 1. Leave blank: automatically uses request host or local Wi-Fi IP (for seamless mobile phone testing)
# 2. Public domain: https://video.yourdomain.com
# 3. Local Wi-Fi IP: http://192.168.1.50:5000
# 4. Ngrok / Cloudflare tunnel: https://xxxx.ngrok-free.app
BASE_URL=

# Database Configuration
# Set USE_MYSQL=true to connect to MySQL database
USE_MYSQL=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=video_qr_db

# Or use direct Database URL (overrides individual MySQL fields if provided)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/video_qr_db

# Upload Limits
MAX_CONTENT_LENGTH_MB=500

# Default Admin Credentials (created automatically on first launch)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
